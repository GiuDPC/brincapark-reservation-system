# Puerto del servidor
PORT=4000

# URL de conexion a MongoDB Atlas
MONGO_URI=mongodb+srv://usuario:password@cluster.mongodb.net/brincapark

# Clave maestra para acceso administrativo privado (definir en Render / Servidor)
ADMIN_SECRET=tu_clave_secreta_maestra_aqui

# Clave pública para acceso de prueba / evaluadores / reclutadores
DEMO_SECRET=1234

# Clave secreta para firma de tokens JWT (generar con openssl rand -hex 32)
JWT_SECRET=tu_jwt_secret_criptografico_aqui
